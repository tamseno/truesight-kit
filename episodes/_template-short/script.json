{
 "meta": { "title": "NEW SHORT", "format": "vertical", "look": "clean", "edge_voice": "en-US-AndrewMultilingualNeural", "edge_rate": "+8%", "say": {},
   "lead": 0.15, "gap": 0.18, "tail": 0.35,
   "cast": { "bot": { "name": "[Bot]", "role": "[role]", "c": "#5a5cf0", "shape": "square" } } },
 "scenes": [
  { "id": "h1", "type": "compose", "theme": "paper", "chapter": "short",
    "lines": ["You're doing [thing] wrong.", "Most people [the usual way]."],
    "data": { "els": [
      { "el": "text", "style": "display", "text": "You're doing\n[thing]\n*wrong*.", "size": 120, "box": [72, 280, 876, 420], "in": "words@0", "do": ["hl@wrong"] },
      { "el": "bubble", "from": "you", "text": "[what most people type]", "box": [72, 800, 876, 130], "in": "right@Most" },
      { "el": "tag", "text": "[THE USUAL WAY]", "color": "bad", "filled": true, "size": 30, "box": [72, 980, 460, 72], "in": "stamp@usual" } ] } },
  { "id": "h2", "type": "compose", "theme": "peach", "chapter": "short", "trans": "cut",
    "lines": ["The people who built it do [the opposite]."],
    "data": { "layout": { "type": "split", "ratio": 0.42, "gap": 60 }, "els": [
      { "el": "card", "slot": "left", "tone": "bad", "icon": "x", "kicker": "[Everyone]", "title": "[the usual way]", "in": "rise@people", "do": ["dim@opposite"] },
      { "el": "card", "slot": "right", "tone": "good", "icon": "check", "kicker": "[The builders]", "title": "[the opposite]", "body": "[one line on how]", "in": "tilt@opposite" } ] } },
  { "id": "h3", "type": "compose", "theme": "mint", "chapter": "short", "trans": "whip",
    "lines": ["Here's how it works: [step one], then [step two], then [step three]."],
    "data": { "layout": { "type": "row", "n": 3, "gap": 70 }, "els": [
      { "id": "p1", "el": "card", "slot": 0, "icon": "chat", "title": "[Step one]", "in": "rise@one" },
      { "id": "p2", "el": "card", "slot": 1, "icon": "term", "title": "[Step two]", "in": "rise@two" },
      { "id": "p3", "el": "card", "slot": 2, "icon": "check", "title": "[Step three]", "in": "rise@three", "do": ["glow@three+0.4"] },
      { "el": "arrow", "from": "p1", "to": "p2", "bend": 0, "in": "fade@two" }, { "el": "arrow", "from": "p2", "to": "p3", "bend": 0, "in": "fade@three" } ] } },
  { "id": "h4", "type": "compose", "theme": "sky", "chapter": "short", "trans": "zoom",
    "lines": ["The result: [two hundred] [things] at once."],
    "data": { "els": [
      { "el": "number", "value": 200, "suffix": "+", "label": "[what the number counts]", "align": "center", "size": 190, "box": [72, 260, 876, 280], "in": "zoom@result" },
      { "el": "tiles", "count": 200, "cols": 20, "steps": [{ "n": 15, "at": "result", "color": "ink" }, { "n": 200, "at": "once" }], "box": [72, 620, 876, 560], "in": "fade@result" } ] } },
  { "id": "h5", "type": "compose", "theme": "paper", "chapter": "short", "trans": "cut",
    "lines": ["So stop [the usual way]. Start [the opposite]. Full breakdown on the channel."],
    "data": { "els": [
      { "el": "text", "style": "display", "text": "[The usual way]", "align": "center", "box": [72, 330, 876, 140], "in": "chars@stop", "do": ["strike@Start"] },
      { "el": "text", "style": "display", "text": "[The *opposite*]", "align": "center", "box": [72, 540, 876, 160], "in": "mask@Start", "do": ["hl@opposite"] },
      { "el": "tag", "icon": "play", "text": "FULL VIDEO ON THE CHANNEL", "color": "accent", "filled": true, "size": 28, "align": "center", "box": [110, 820, 800, 76], "in": "pop@breakdown" } ] } }
 ]
}
